<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\Lumine.Fairy.ContactManagement.App\Lumine.Fairy.ContactManagement.App.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\Lumine.Fairy.TodoList.App\Lumine.Fairy.TodoList.App.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumine.Fairy.Domain\Lumine.Fairy.Domain.csproj" />
    <ProjectReference Include="..\Lumine.Fairy.Protocol\Lumine.Fairy.Protocol.csproj" />
    <ProjectReference Include="..\Lumine.Fairy.Application\Lumine.Fairy.Application.csproj" />
    <ProjectReference Include="..\Lumine.Fairy.Infrastructure\Lumine.Fairy.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Lumine.Fairy.ContactManagement.Abstractions\Lumine.Fairy.ContactManagement.Abstractions.csproj" />
    <ProjectReference Include="..\..\Lumine.Fairy.ContactManagement.Infrastructure\Lumine.Fairy.ContactManagement.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Win32Icon>Assets\fairy-shortcut.ico</Win32Icon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\fairy-shortcut.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyBuiltInAppArtifacts" AfterTargets="Build">
    <ItemGroup>
      <ContactManagementAppProjectReference Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' == 'Lumine.Fairy.ContactManagement.App'" />
      <ContactManagementAppOutputDirectory Include="%(ContactManagementAppProjectReference.RootDir)%(ContactManagementAppProjectReference.Directory)bin\$(Configuration)\net10.0-windows" />
      <ContactManagementAppArtifacts Include="%(ContactManagementAppOutputDirectory.Identity)\**\*"
                                     Exclude="%(ContactManagementAppOutputDirectory.Identity)\**\*.pdb;%(ContactManagementAppOutputDirectory.Identity)\**\*.xml" />
      <TodoListAppProjectReference Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' == 'Lumine.Fairy.TodoList.App'" />
      <TodoListAppOutputDirectory Include="%(TodoListAppProjectReference.RootDir)%(TodoListAppProjectReference.Directory)bin\$(Configuration)\net10.0-windows" />
      <TodoListAppArtifacts Include="%(TodoListAppOutputDirectory.Identity)\**\*"
                            Exclude="%(TodoListAppOutputDirectory.Identity)\**\*.pdb;%(TodoListAppOutputDirectory.Identity)\**\*.xml" />
    </ItemGroup>

    <MakeDir Directories="$(OutDir)tools\contact-management;$(OutDir)tools\todolist" />
    <Copy SourceFiles="@(ContactManagementAppArtifacts)"
          DestinationFiles="@(ContactManagementAppArtifacts->'$(OutDir)tools\contact-management\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="@(ContactManagementAppArtifacts) != ''" />
    <Copy SourceFiles="@(TodoListAppArtifacts)"
          DestinationFiles="@(TodoListAppArtifacts->'$(OutDir)tools\todolist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="@(TodoListAppArtifacts) != ''" />
  </Target>
</Project>
