<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Lumine.Fairy.ContactManagement.App.Dialogs"
		xmlns:vm="using:Lumine.Fairy.ContactManagement.App.ViewModels"
		x:Class="Lumine.Fairy.ContactManagement.App.Dialogs.ProjectEditorWindow"
		x:DataType="local:ProjectEditorWindow"
		Width="580"
		Height="700"
		MinWidth="560"
		MinHeight="640"
		FontSize="13"
		Title="项目编辑"
		WindowStartupLocation="CenterOwner"
		CanResize="False"
		mc:Ignorable="d">
	<Grid RowDefinitions="*,Auto" Margin="18">
		<ScrollViewer>
			<StackPanel Spacing="10" Margin="0,0,18,0">
				<TextBlock FontSize="18" FontWeight="SemiBold" Text="项目信息" />
				<Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
					<TextBlock VerticalAlignment="Center" Text="项目名称" />
					<TextBox Grid.Column="1" Width="400" Watermark="项目名称" HorizontalAlignment="Left" Text="{Binding Item.Name}" />

					<TextBlock Grid.Row="1" VerticalAlignment="Top" Text="所属公司" Margin="0,6,0,0" />
					<Border Grid.Row="1" Grid.Column="1" Width="400" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
						<StackPanel Spacing="8">
							<TextBox Height="30" Watermark="筛选公司" TextChanged="CompanyFilterTextBox_TextChanged" />
							<ItemsControl ItemsSource="{Binding SelectedCompanyOptions}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:LookupOptionViewModel">
										<Border Margin="0,0,6,6" Padding="8,4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#1D4ED8" Text="{Binding DisplayName}" />
												<Button Width="18" Height="18" Padding="0" Click="RemoveCompanyTag_Click" Background="Transparent" BorderThickness="0" Foreground="#1D4ED8" Content="×" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Border Padding="8" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
								<ScrollViewer Height="108">
									<ItemsControl ItemsSource="{Binding FilteredCompanyOptions}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:LookupOptionViewModel">
												<Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="SelectCompanyOption_Click">
													<DockPanel LastChildFill="True">
														<TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#2563EB" IsVisible="{Binding IsSelected}" Text="已选" />
														<TextBlock Text="{Binding DisplayName}" />
													</DockPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
						</StackPanel>
					</Border>

					<TextBlock Grid.Row="2" VerticalAlignment="Top" Text="负责人" Margin="0,6,0,0" />
					<Border Grid.Row="2" Grid.Column="1" Width="400" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
						<StackPanel Spacing="8">
							<TextBox Height="30" Watermark="筛选联系人" TextChanged="ContactFilterTextBox_TextChanged" />
							<ItemsControl ItemsSource="{Binding SelectedContactOptions}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:LookupOptionViewModel">
										<Border Margin="0,0,6,6" Padding="8,4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="999">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#047857" Text="{Binding DisplayName}" />
												<Button Width="18" Height="18" Padding="0" Click="RemoveContactTag_Click" Background="Transparent" BorderThickness="0" Foreground="#047857" Content="×" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Border Padding="8" CornerRadius="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
								<ScrollViewer Height="108">
									<ItemsControl ItemsSource="{Binding FilteredContactOptions}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:LookupOptionViewModel">
												<Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Click="SelectContactOption_Click">
													<DockPanel LastChildFill="True">
														<TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#059669" IsVisible="{Binding IsSelected}" Text="已选" />
														<TextBlock Text="{Binding DisplayName}" />
													</DockPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
						</StackPanel>
					</Border>

					<TextBlock Grid.Row="3" VerticalAlignment="Center" Text="交付日期" />
					<DatePicker Grid.Row="3" Grid.Column="1" Width="400" HorizontalAlignment="Left" SelectedDate="{Binding Item.DeliveryDate}" />

					<TextBlock Grid.Row="4" VerticalAlignment="Center" Text="标签" />
					<TextBox Grid.Row="4" Grid.Column="1" Width="400" HorizontalAlignment="Left" Watermark="标签，使用 ; 分隔" Text="{Binding Item.TagsText}" />

					<TextBlock Grid.Row="5" VerticalAlignment="Center" Text="项目群聊" />
					<TextBox Grid.Row="5" Grid.Column="1" Width="400" HorizontalAlignment="Left" Watermark="微信群、QQ群等，使用 ; 分隔" Text="{Binding Item.GroupChatsText}" />

					<TextBlock Grid.Row="6" VerticalAlignment="Center" Text="状态" />
					<CheckBox Grid.Row="6" Grid.Column="1" Content="启用" IsChecked="{Binding Item.IsActive}" />

					<TextBlock Grid.Row="7" VerticalAlignment="Top" Text="备注" Margin="0,6,0,0" />
					<TextBox Grid.Row="7"
							 Grid.Column="1"
							 Width="400"
							 HorizontalAlignment="Left"
							 Watermark="备注"
							 AcceptsReturn="True"
							 TextWrapping="Wrap"
							 Height="132"
							 VerticalContentAlignment="Top"
							 Text="{Binding Item.Notes}" />
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="1"
					Margin="0,12,0,0"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="8">
			<Button Content="取消" Click="Cancel_Click" MinWidth="82" Height="30" />
			<Button Content="保存" Click="Save_Click" MinWidth="82" Height="30" />
		</StackPanel>
	</Grid>
</Window>
